{
  "name": "shasta-land-map",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Interactive Siskiyou County public auction and private land map",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "refresh": "node scripts/refresh-data.js",
    "layers:download": "node scripts/download-layers.js",
    "layers:build": "node scripts/make-pmtiles.js",
    "build": "vite build",
    "test": "node scripts/test.js && node scripts/test-parcel-resolver.js",
    "release": "npm run test && npm run deploy",
    "deploy": "npm run build && node scripts/deploy.js"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "pdfjs-dist": "^5.4.149",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^6.3.0",
    "pmtiles": "^4.5.0"
  }
}
